{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/playon/pulse/tools/checkin-worker/contract/pulse.telemetry.v1.schema.json",
  "title": "Pulse telemetry v1 and check-in envelope",
  "description": "Canonical wire shapes, not an ingest replacement: malformed optional values are normalized or dropped by ingest.js. Only checkinId is mandatory in an envelope; only schema is mandatory in a telemetry document. Unknown fields remain allowed for additive v1 evolution. producedTelemetry and producedCheckin pin current builder field names (including nullable unknowns) to catch accidental renames. UTF-8 byte caps and clock skew are tested separately.",
  "anyOf": [
    {
      "$ref": "#/$defs/checkin"
    },
    {
      "$ref": "#/$defs/telemetry"
    }
  ],
  "$defs": {
    "checkin": {
      "type": "object",
      "properties": {
        "sentAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "hostname": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "serialNumber": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "venueId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "vpuName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "pulseVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "channel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "osBuild": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "ubr": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "checkinId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{8,64}$"
        },
        "reason": {
          "enum": [
            "startup",
            "periodic",
            "state-change",
            "heartbeat",
            "paused",
            "event-start",
            "event-update",
            "event-end"
